{
  "name": "aftersales-workbench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "element-plus": "^2.11.0",
    "pinia": "4.1.0",
    "vue": "^3.5.0",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "^3.1.0"
  }
}
