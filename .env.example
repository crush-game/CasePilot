POSTGRES_PASSWORD=replace_with_a_local_random_password
POSTGRES_PORT=55432
AFTERSALES_DATABASE_URL=postgresql://aftersales:replace_with_a_local_random_password@127.0.0.1:55432/aftersales
AFTERSALES_TEST_DATABASE_URL=postgresql://aftersales:replace_with_a_local_random_password@127.0.0.1:55432/aftersales_test
AFTERSALES_MODEL_PROVIDER=mock
# 新建工单的图版本；supervisor-v1知识调查，supervisor-v2增加故障调查，二者会调用模型服务。
AFTERSALES_WORKFLOW_GRAPH_VERSION=mock-v1
# 仅本项目的密钥；不要把真实值提交到 Git。P06 live 小集显式启用真实服务。
AFTERSALES_PROVIDER_API_KEY=
AFTERSALES_PROVIDER_CONFIG_PATH=config/providers.siliconflow.json
# 可选：手动创建的共享预算 UUID；live 小集自动创建独立预算，不需要填此项。
# AFTERSALES_PROVIDER_BUDGET_ID=
AFTERSALES_MODEL_PROFILES={"solution":{"provider":"mock","model":"deterministic-v1","timeout_seconds":5.0},"domain":{"provider":"mock","model":"deterministic-v1","timeout_seconds":5.0}}
AFTERSALES_ENTERPRISE_DATA_PROVIDER=mock
# supervisor-v2仅从fixtures/enterprise读取公开样例，不访问企业后台；新建运行冻结校验和。
AFTERSALES_ENTERPRISE_MOCK_FIXTURE=p08-demo
AFTERSALES_SESSION_TTL_SECONDS=28800
AFTERSALES_COOKIE_SECURE=false
AFTERSALES_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
AFTERSALES_WORKER_LEASE_SECONDS=30
AFTERSALES_WORKER_POLL_SECONDS=1
AFTERSALES_INGESTION_LEASE_SECONDS=60
AFTERSALES_RUN_TIMEOUT_SECONDS=300
AFTERSALES_MAX_BUDGET_EPOCHS=5
AFTERSALES_MAX_MOCK_STEPS=24
AFTERSALES_MAX_AGENT_STEPS=64

# 可选人工服务日历，星期一为 0，时间使用北京时间。
